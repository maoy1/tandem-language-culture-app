{
  "version": 3,
  "deploymentStatus": "issue6_studio_cards_added_choice_binding_and_tests_pending",
  "list": "Participants",
  "identity": {
    "field": "ParticipantAccount",
    "source": "authenticated_user",
    "required": true,
    "unique": true,
    "participantEditable": false
  },
  "access": {
    "approvalRequired": false,
    "participantCreate": "own_profile",
    "participantRead": "app_filtered_own_profile",
    "participantUpdate": "app_filtered_own_profile",
    "participantDelete": false,
    "administratorAccess": "all_profiles",
    "sharepointItemLevelPermissions": "unavailable_with_unique_identity"
  },
  "form": {
    "mode": "create_or_edit_own_profile",
    "visibleFields": [
      "ParticipantAccount",
      "TeachLanguages",
      "LearnLanguages",
      "ShareCultures",
      "LearnCultures",
      "TimeZone",
      "LearningFocus",
      "Comments",
      "ParticipationStatus",
      "OpenToConnections"
    ],
    "hiddenFields": [
      "Title",
      "Status"
    ]
  },
  "validation": {
    "requireAnyOf": [
      "TeachLanguages",
      "LearnLanguages",
      "ShareCultures",
      "LearnCultures"
    ],
    "optionalCatalogueFields": [
      "TimeZone"
    ],
    "rejectInactiveSelections": true
  },
  "participation": {
    "field": "ParticipationStatus",
    "opennessField": "OpenToConnections",
    "allowedValues": [
      "Active",
      "Paused",
      "Inactive"
    ],
    "newProfileDefault": "Active",
    "newProfileOpenDefault": true,
    "defaultSource": "sharepoint_form_new_mode",
    "defaultsApplyOnlyToNewProfiles": true,
    "preserveExistingChoices": true,
    "validationMayReset": false,
    "membershipSideEffects": "none",
    "binding": "generated_sharepoint_data_cards"
  }
}
