{
  "version": 1,
  "list": "Participants",
  "identity": {
    "field": "ParticipantAccount",
    "source": "authenticated_user",
    "required": true,
    "unique": true,
    "participantEditable": false
  },
  "access": {
    "approvalRequired": false,
    "participantCreate": "own_profile",
    "participantRead": "own_profile",
    "participantUpdate": "own_profile",
    "participantDelete": false,
    "administratorAccess": "all_profiles"
  },
  "form": {
    "mode": "create_or_edit_own_profile",
    "visibleFields": [
      "ParticipantAccount",
      "TeachLanguages",
      "LearnLanguages",
      "Location",
      "LearningFocus",
      "Comments"
    ],
    "hiddenFields": [
      "Title",
      "TimeZone",
      "Status"
    ]
  }
}
