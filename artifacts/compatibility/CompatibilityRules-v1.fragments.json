          "runAfter": {}
        },
        "CompatibilityGroup_Culture_Sharers_ids": {
          "type": "Select",
          "inputs": {
            "from": "@body('CompatibilityGroup_Culture_Sharers')",
            "select": "@item()?['profileId']"
          },
          "runAfter": {
