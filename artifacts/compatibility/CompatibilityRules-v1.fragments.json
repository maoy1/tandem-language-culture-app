              "Succeeded"
            ]
          }
        },
        "CompatibilityGroup_Culture_Learners": {
          "type": "Query",
          "inputs": {
            "from": "@body('Current_members')",
            "where": "@and(equals(item()?['status'],'Active'),contains(item()?['learnCultureIds'],items('CompatibilityGroup_Culture_focus')))"
          },
          "runAfter": {
            "CompatibilityGroup_Culture_Sharers_ids": [
              "Succeeded"
            ]
          }
        },
        "CompatibilityGroup_Culture_Learners_ids": {
          "type": "Select",
          "inputs": {
            "from": "@body('CompatibilityGroup_Culture_Learners')",
            "select": "@item()?['profileId']"
          },
          "runAfter": {
            "CompatibilityGroup_Culture_Learners": [
              "Succeeded"
            ]
          }
        },
        "CompatibilityGroup_Culture_Check": {
