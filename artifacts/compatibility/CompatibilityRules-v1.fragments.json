    },
    "Compatibility_Require_valid_input": {
      "type": "If",
      "expression": "@and(empty(body('Compatibility_Invalid_profiles')),equals(length(body('Compatibility_Keys_accountKey')),length(union(body('Compatibility_Keys_accountKey'),body('Compatibility_Keys_accountKey')))),equals(length(body('Compatibility_Keys_profileId')),length(union(body('Compatibility_Keys_profileId'),body('Compatibility_Keys_profileId')))))",
      "runAfter": {
        "Compatibility_Keys_profileId": [
          "Succeeded"
        ]
      },
      "actions": {},
      "else": {
        "actions": {
          "Compatibility_Reject_input": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
