  "rulesVersion": 1,
  "note": "Generated review material, not a standalone import flow. Rebuild from compatibility.py; adapters must supply trusted complete inputs and post-guard dependencies.",
  "normalization": {
    "Compatibility_Parse_profiles": {
      "type": "ParseJson",
      "inputs": {
        "content": "@outputs('Trusted_profiles')",
        "schema": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "profileId",
              "accountKey",
              "status",
              "participationStatus",
              "openToConnections"
            ],
            "properties": {
              "profileId": {
                "type": "integer",
                "minimum": 1
              },
              "accountKey": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "participationStatus": {
                "type": "string",
                "enum": [
                  "Active",
                  "Paused",
                  "Inactive"
                ]
              },
              "openToConnections": {
                "type": "boolean"
              },
              "timezoneId": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "teachIds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "learnIds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "shareCultureIds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "learnCultureIds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "runAfter": {}
    },
    "Compatibility_Parse_catalogues": {
      "type": "ParseJson",
      "inputs": {
        "content": "@outputs('Trusted_catalogues')",
        "schema": {
          "type": "object",
          "required": [
            "languageIds",
            "cultureIds",
            "timezoneIds",
            "anyLanguageId"
          ],
          "properties": {
            "languageIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "cultureIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "timezoneIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "anyLanguageId": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      },
      "runAfter": {
        "Compatibility_Parse_profiles": [
          "Succeeded"
        ]
      }
    },
    "Compatibility_Concrete_languages": {
      "type": "Query",
      "inputs": {
        "from": "@body('Compatibility_Parse_catalogues')?['languageIds']",
        "where": "@not(equals(item(),body('Compatibility_Parse_catalogues')?['anyLanguageId']))"
