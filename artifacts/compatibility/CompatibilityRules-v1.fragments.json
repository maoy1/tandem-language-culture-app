              "Succeeded"
            ]
          }
        },
        "CompatibilityGroup_Language_Learners": {
          "type": "Query",
          "inputs": {
            "from": "@body('Current_members')",
            "where": "@and(equals(item()?['status'],'Active'),contains(item()?['learnIds'],items('CompatibilityGroup_Language_focus')))"
          },
          "runAfter": {
