              "supported": "@and(not(empty(body('CompatibilityGroup_Language_Sharers_ids'))),not(empty(body('CompatibilityGroup_Language_Learners_ids'))),greater(length(union(body('CompatibilityGroup_Language_Sharers_ids'),body('CompatibilityGroup_Language_Learners_ids'))),1))"
            }
          },
          "runAfter": {
            "CompatibilityGroup_Language_Learners_ids": [
              "Succeeded"
            ]
          }
        }
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "runAfter": {}
    },
    "CompatibilityGroup_Culture_focus": {
