  "Each_smoke_case": {
    "type": "Foreach",
    "foreach": "@outputs('Smoke_cases')",
    "actions": {
      "Call_validation_child": {
        "type": "Workflow",
        "inputs": {
          "host": {
            "workflowReferenceName": "e9aa88eb-a666-4df1-b088-176be7bcd00d"
          },
          "body": {
            "text": "@string(items('Each_smoke_case')?['payload'])"
          }
        },
        "runAfter": {}
      },
      "Parse_child_result": {
        "type": "ParseJson",
        "inputs": {
          "content": "@json(body('Call_validation_child')?['resultjson'])",
          "schema": {
            "type": "object"
          }
        },
        "runAfter": {
          "Call_validation_child": [
            "Succeeded"
          ]
        }
      },
      "Append_smoke_result": {
        "type": "AppendToArrayVariable",
        "runAfter": {
          "Parse_child_result": [
            "Succeeded"
          ]
        },
        "inputs": {
          "name": "Results",
          "value": {
            "id": "@items('Each_smoke_case')?['id']",
            "passed": "@and(equals(body('Parse_child_result')?['code'],items('Each_smoke_case')?['code']),equals(body('Parse_child_result')?['result'],items('Each_smoke_case')?['expected']),equals(body('Parse_child_result')?['packageBuildId'],'c79b7b64-b3ce-4de3-aa74-0ed62bca1524'))",
            "childRunReference": "@body('Parse_child_result')?['runReference']",
            "actual": "@body('Parse_child_result')?['result']",
            "actualCode": "@body('Parse_child_result')?['code']",
            "expectedCode": "@items('Each_smoke_case')?['code']",
            "diagnostics": "@body('Parse_child_result')?['diagnostics']"
          }
        }
      }
    },
    "runtimeConfiguration": {
      "concurrency": {
        "repetitions": 1
      }
    },
    "runAfter": {
      "Smoke_cases": [
        "Succeeded"
      ]
    }
  },
  "Failed_cases": {
    "type": "Query",
    "inputs": {
      "from": "@variables('Results')",
      "where": "@not(equals(item()?['passed'],true))"
    },
    "runAfter": {
      "Each_smoke_case": [
        "Succeeded",
        "Failed",
        "Skipped",
        "TimedOut"
      ]
    }
  },
  "Smoke_report": {
    "type": "Compose",
    "inputs": {
      "kind": "TandemValidationSmoke",
      "suite": "QUICK",
      "sourceTicket": 81,
      "packageBuildId": "c79b7b64-b3ce-4de3-aa74-0ed62bca1524",
      "syntheticOnly": true,
      "runReference": "@workflow()?['run']?['name']",
      "testCount": 3,
      "completedCount": "@length(variables('Results'))",
      "allPassed": "@and(equals(actions('Each_smoke_case')?['status'],'Succeeded'),empty(body('Failed_cases')),equals(length(variables('Results')),3))",
      "failedCases": "@body('Failed_cases')",
      "connectors": 0,
      "reads": 0,
      "writes": 0
    },
    "runAfter": {
      "Failed_cases": [
        "Succeeded"
      ]
    }
  }
}
