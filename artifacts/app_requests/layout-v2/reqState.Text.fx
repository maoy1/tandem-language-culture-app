If(varReqBusy, "Loading saved requests…", If(!IsBlank(varReqError), varReqError, Switch(varReqTab, "Sent", "Sent requests: waiting for a reply. Select one to view or withdraw it.", "Received", "Received requests: select an invitation to accept or decline.", "Group incoming", "Group requests: review invitations to join your groups.", "History", "History: requests that were accepted, declined or withdrawn.", "Choose Sent, Received, Group incoming or History.")))
